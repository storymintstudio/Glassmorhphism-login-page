<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Syne:wght@600;700&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ── Galaxy Background ── */
    body {
      min-height: 100vh;
      font-family: 'Inter', sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background: #05050f;
      position: relative;
    }

    /* Deep space nebula layers */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 60% at 20% 30%, #1a0638 0%, transparent 60%),
        radial-gradient(ellipse 60% 80% at 80% 70%, #0a1a4a 0%, transparent 55%),
        radial-gradient(ellipse 50% 50% at 50% 50%, #0d0620 0%, transparent 70%),
        radial-gradient(ellipse 40% 40% at 70% 20%, #2d0845 0%, transparent 50%),
        radial-gradient(ellipse 70% 40% at 10% 80%, #06103a 0%, transparent 60%);
      z-index: 0;
    }

    /* Stars layer 1 — small */
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        radial-gradient(1px 1px at 10% 15%, rgba(255,255,255,0.8) 0%, transparent 100%),
        radial-gradient(1px 1px at 25% 40%, rgba(255,255,255,0.6) 0%, transparent 100%),
        radial-gradient(1px 1px at 40% 10%, rgba(255,255,255,0.9) 0%, transparent 100%),
        radial-gradient(1px 1px at 55% 60%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(1px 1px at 70% 25%, rgba(255,255,255,0.7) 0%, transparent 100%),
        radial-gradient(1px 1px at 85% 75%, rgba(255,255,255,0.8) 0%, transparent 100%),
        radial-gradient(1px 1px at 15% 70%, rgba(255,255,255,0.6) 0%, transparent 100%),
        radial-gradient(1px 1px at 90% 10%, rgba(255,255,255,0.9) 0%, transparent 100%),
        radial-gradient(1px 1px at 60% 85%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(1px 1px at 35% 55%, rgba(255,255,255,0.7) 0%, transparent 100%),
        radial-gradient(1.5px 1.5px at 5%  45%, rgba(200,180,255,0.8) 0%, transparent 100%),
        radial-gradient(1.5px 1.5px at 78% 50%, rgba(180,200,255,0.7) 0%, transparent 100%),
        radial-gradient(1px 1px at 48% 30%, rgba(255,255,255,0.9) 0%, transparent 100%),
        radial-gradient(1px 1px at 93% 40%, rgba(255,255,255,0.6) 0%, transparent 100%),
        radial-gradient(1px 1px at 20% 88%, rgba(255,255,255,0.8) 0%, transparent 100%),
        radial-gradient(2px 2px at 65% 5%,  rgba(220,200,255,0.9) 0%, transparent 100%),
        radial-gradient(1px 1px at 30% 20%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(1px 1px at 75% 90%, rgba(255,255,255,0.7) 0%, transparent 100%),
        radial-gradient(1px 1px at 50% 50%, rgba(255,255,255,0.4) 0%, transparent 100%),
        radial-gradient(1.5px 1.5px at 88% 30%, rgba(200,220,255,0.8) 0%, transparent 100%);
      z-index: 0;
      animation: twinkle 6s ease-in-out infinite alternate;
    }

    @keyframes twinkle {
      0%   { opacity: 0.7; }
      100% { opacity: 1; }
    }

    /* Floating orbs for ambiance */
    .orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(80px);
      z-index: 0;
      pointer-events: none;
    }

    .orb-1 {
      width: 400px; height: 400px;
      background: radial-gradient(circle, #4f1580 0%, transparent 70%);
      top: -100px; left: -100px;
      animation: floatOrb 10s ease-in-out infinite alternate;
    }

    .orb-2 {
      width: 350px; height: 350px;
      background: radial-gradient(circle, #0f2f7a 0%, transparent 70%);
      bottom: -80px; right: -80px;
      animation: floatOrb 12s ease-in-out infinite alternate-reverse;
    }

    .orb-3 {
      width: 250px; height: 250px;
      background: radial-gradient(circle, #6b1fa0 0%, transparent 70%);
      top: 50%; right: 15%;
      animation: floatOrb 8s ease-in-out infinite alternate;
    }

    @keyframes floatOrb {
      0%   { transform: translate(0, 0) scale(1); }
      100% { transform: translate(30px, 40px) scale(1.1); }
    }

    /* ── Glass Card ── */
    .card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 420px;
      padding: 44px 40px;
      background: rgba(255, 255, 255, 0.04);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-top-color: rgba(255, 255, 255, 0.18);
      border-radius: 24px;
      box-shadow:
        0 0 0 1px rgba(255,255,255,0.03),
        0 40px 80px rgba(0,0,0,0.5),
        inset 0 1px 0 rgba(255,255,255,0.1);
      animation: cardIn 0.7s cubic-bezier(0.16,1,0.3,1) both;
    }

    @keyframes cardIn {
      from { opacity: 0; transform: translateY(24px) scale(0.97); }
      to   { opacity: 1; transform: translateY(0)    scale(1);    }
    }

    /* top glow line — signature element */
    .card::before {
      content: '';
      position: absolute;
      top: -1px; left: 20%; right: 20%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(160,100,255,0.8), rgba(100,160,255,0.8), transparent);
      border-radius: 999px;
    }

    /* ── Header ── */
    .card-header {
      text-align: center;
      margin-bottom: 32px;
    }

    .logo-ring {
      width: 52px; height: 52px;
      margin: 0 auto 16px;
      border-radius: 14px;
      background: linear-gradient(135deg, #7c3aed, #2563eb);
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 0 24px rgba(124,58,237,0.4);
    }

    .logo-ring svg { width: 24px; height: 24px; fill: white; }

    h1 {
      font-family: 'Syne', sans-serif;
      font-size: 24px;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }

    .subtitle {
      font-size: 13px;
      color: rgba(255,255,255,0.4);
      font-weight: 400;
    }

    /* ── Google Button ── */
    .btn-google {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 12px;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 12px;
      color: rgba(255,255,255,0.85);
      font-size: 14px;
      font-weight: 500;
      font-family: 'Inter', sans-serif;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s, transform 0.15s;
      margin-bottom: 24px;
    }

    .btn-google:hover {
      background: rgba(255,255,255,0.1);
      border-color: rgba(255,255,255,0.2);
      transform: translateY(-1px);
    }

    .btn-google:active { transform: translateY(0); }

    .btn-google svg { width: 18px; height: 18px; flex-shrink: 0; }

    /* ── Divider ── */
    .divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
    }

    .divider span {
      font-size: 12px;
      color: rgba(255,255,255,0.25);
      white-space: nowrap;
    }

    .divider::before, .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: rgba(255,255,255,0.08);
    }

    /* ── Floating Label Inputs ── */
    .field {
      position: relative;
      margin-bottom: 18px;
    }

    .field input {
      width: 100%;
      padding: 16px 16px 8px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px;
      color: #ffffff;
      font-size: 14px;
      font-family: 'Inter', sans-serif;
      outline: none;
      transition: border-color 0.25s, background 0.25s, box-shadow 0.25s;
    }

    .field input:focus {
      border-color: rgba(124,58,237,0.6);
      background: rgba(255,255,255,0.07);
      box-shadow: 0 0 0 3px rgba(124,58,237,0.12);
    }

    .field label {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 14px;
      color: rgba(255,255,255,0.35);
      pointer-events: none;
      transition: all 0.2s cubic-bezier(0.4,0,0.2,1);
    }

    .field input:focus + label,
    .field input:not(:placeholder-shown) + label {
      top: 10px;
      transform: translateY(0);
      font-size: 10px;
      color: rgba(160,100,255,0.9);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    /* eye toggle */
    .eye-btn {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      color: rgba(255,255,255,0.3);
      padding: 4px;
      transition: color 0.2s;
    }

    .eye-btn:hover { color: rgba(255,255,255,0.7); }
    .eye-btn svg { width: 16px; height: 16px; }

    /* forgot */
    .forgot {
      text-align: right;
      margin-top: -10px;
      margin-bottom: 22px;
    }

    .forgot a {
      font-size: 12px;
      color: rgba(160,100,255,0.8);
      text-decoration: none;
      transition: color 0.2s;
    }

    .forgot a:hover { color: rgba(160,100,255,1); }

    /* ── Sign In Button ── */
    .btn-signin {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, #7c3aed 0%, #2563eb 100%);
      border: none;
      border-radius: 12px;
      color: #ffffff;
      font-size: 14px;
      font-weight: 600;
      font-family: 'Inter', sans-serif;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      transition: transform 0.15s, box-shadow 0.25s;
      box-shadow: 0 4px 24px rgba(124,58,237,0.35);
    }

    .btn-signin::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 60%);
      opacity: 0;
      transition: opacity 0.2s;
    }

    .btn-signin:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 32px rgba(124,58,237,0.5);
    }

    .btn-signin:hover::before { opacity: 1; }
    .btn-signin:active { transform: translateY(0); }

    /* ── Footer ── */
    .card-footer {
      text-align: center;
      margin-top: 22px;
      font-size: 13px;
      color: rgba(255,255,255,0.3);
    }

    .card-footer a {
      color: rgba(160,100,255,0.9);
      text-decoration: none;
      font-weight: 500;
      transition: color 0.2s;
    }

    .card-footer a:hover { color: rgba(160,100,255,1); }

    /* ── Responsive ── */
    @media (max-width: 480px) {
      .card { padding: 36px 24px; margin: 20px; }
    }
  </style>
</head>
<body>

  <!-- Ambient orbs -->
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>

  <!-- Login Card -->
  <div class="card">

    <div class="card-header">
      <div class="logo-ring">
        <!-- star icon -->
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/>
        </svg>
      </div>
      <h1>Welcome back</h1>
      <p class="subtitle">Sign in to continue your journey</p>
    </div>

    <!-- Google -->
    <button class="btn-google">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
      </svg>
      Continue with Google
    </button>

    <!-- Divider -->
    <div class="divider"><span>or continue with email</span></div>

    <!-- Email -->
    <div class="field">
      <input type="email" id="email" placeholder=" " autocomplete="off"/>
      <label for="email">Email address</label>
    </div>

    <!-- Password -->
    <div class="field">
      <input type="password" id="password" placeholder=" " autocomplete="off" style="padding-right: 44px;"/>
      <label for="password">Password</label>
      <button class="eye-btn" onclick="togglePassword()" type="button" aria-label="Toggle password">
        <svg id="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </button>
    </div>

    <!-- Forgot -->
    <div class="forgot"><a href="#">Forgot password?</a></div>

    <!-- Sign In -->
    <button class="btn-signin">Sign in</button>

    <!-- Footer -->
    <div class="card-footer">
      Don't have an account? <a href="#">Sign up</a>
    </div>

  </div>

  <script>
    function togglePassword() {
      const input = document.getElementById('password');
      const icon  = document.getElementById('eye-icon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.innerHTML = `
          <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94"/>
          <path d="M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19"/>
          <line x1="1" y1="1" x2="23" y2="23"/>`;
      } else {
        input.type = 'password';
        icon.innerHTML = `
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
          <circle cx="12" cy="12" r="3"/>`;
      }
    }
  </script>

</body>
</html>
